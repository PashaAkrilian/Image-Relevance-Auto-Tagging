# Copy this file to .env and fill in real values. .env is git-ignored --
# never commit real secrets (see .gitignore).

# --- Database (matches docker-compose.yml's postgres service) ---
DATABASE_URL=postgresql+psycopg2://capstone:capstone@localhost:5433/capstone

# --- Vision / embedding provider: "gemini" (cloud, free tier) or "ollama" (local, no key) ---
VISION_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Google AI Studio key (free, no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Only used when VISION_PROVIDER/EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=moondream
OLLAMA_EMBEDDING_MODEL=all-minilm

# --- Mismatch guard thresholds ---
VISION_CONFIDENCE_THRESHOLD=0.60
SIMILARITY_THRESHOLD=0.55

# --- Batch processing ---
BATCH_MAX_RETRIES=3
BATCH_RETRY_BACKOFF_SECONDS=1.5

APP_ENV=development
